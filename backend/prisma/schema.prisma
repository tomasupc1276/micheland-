generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Turno {
  id           Int       @id @default(autoincrement())
  abiertaEn    DateTime  @default(now())
  cerradaEn    DateTime?
  fondoInicial Float     @default(0)
  totalVentas  Float     @default(0)
  totalEgresos Float     @default(0)
  ganancia     Float     @default(0)
  estado       String    @default("abierto")
}

model Mesa {
  id       Int     @id @default(autoincrement())
  numero   Int
  estado   String  @default("abierta")
  ventas   Venta[]
}

model Venta {
  id         Int         @id @default(autoincrement())
  total      Float
  metodoPago String      @default("efectivo")
  nota       String?
  estado     String      @default("pendiente")
  creadoEn   DateTime    @default(now())
  items      ItemVenta[]
  mesaId     Int?
  mesa       Mesa?       @relation(fields: [mesaId], references: [id])
}

model ItemVenta {
  id       Int    @id @default(autoincrement())
  nombre   String
  precio   Float
  cantidad Int
  nota     String @default("")
  ventaId  Int
  venta    Venta  @relation(fields: [ventaId], references: [id])
}

model Egreso {
  id        Int      @id @default(autoincrement())
  concepto  String
  monto     Float
  categoria String   @default("general")
  creadoEn  DateTime @default(now())
}